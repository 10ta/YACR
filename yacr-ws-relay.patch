+say "安装到 $INSTALL_DIR"
+install -d -m 755 "$INSTALL_DIR"
+install -m 644 "$SRC_DIR/server.js" "$SRC_DIR/package.json" "$SRC_DIR/package-lock.json" "$INSTALL_DIR/"
