+
+# ---------- 3. 配置（密钥只生成一次） ----------
+say "写入配置 $ENV_FILE"
+SECRET=""
+if [[ -f "$ENV_FILE" ]]; then
+  SECRET="$(grep -E '^RELAY_SECRET=' "$ENV_FILE" | cut -d= -f2- || true)"
+fi
