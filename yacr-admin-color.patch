From f924850a24426389d8726a5ce21c9b88dd94c783 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Tue, 29 Sep 2026 12:40:48 +0000
Subject: [PATCH] feat: admin can enter rooms from dashboard; wider avatar
 color space

---
 public/admin.html |  7 ++++++-
 public/style.css  |  7 +++++--
 web/app.js        |  5 ++++-
 web/identity.js   | 13 ++++++++++++-
 4 files changed, 27 insertions(+), 5 deletions(-)

diff --git a/public/admin.html b/public/admin.html
index e2c5c08..6141be2 100644
--- a/public/admin.html
+++ b/public/admin.html
@@ -114,7 +114,12 @@
           who.append(list);
           const st = el('td', '', room.locked ? '禁止新人' : '开放');
           const last = el('td', '', ago(room.lastActivity));
-          const act = el('td');
+          const act = el('td', 'actions');
+          const enter = el('a', 'btn small ghost', '进入');
+          enter.href = `/${room.id}`;
+          enter.target = '_blank';
+          enter.rel = 'noopener';
+          act.append(enter);
           const btn = el('button', 'btn small danger', '结束');
           btn.type = 'button';
           btn.onclick = async () => {
diff --git a/public/style.css b/public/style.css
index 8570e55..02bd3f1 100644
--- a/public/style.css
+++ b/public/style.css
@@ -148,7 +148,8 @@ body[data-view='loading'] .screen-dots i:nth-child(3) { animation-delay: 0.3s; }
 .msg { display: flex; gap: 10px; margin-top: 14px; align-items: flex-start; }
 .msg .body { max-width: min(78%, 34em); display: flex; flex-direction: column; align-items: flex-start; }
 .msg .meta { display: flex; gap: 8px; align-items: baseline; font-size: 12px; color: var(--muted); margin-bottom: 3px; }
-.msg .name { color: var(--who); font-weight: 600; }
+/* 名字颜色向正文色靠一点，浅色头像的名字在浅背景上也看得清 */
+.msg .name { color: color-mix(in oklch, var(--who) 72%, var(--ink)); font-weight: 600; }
 .msg .text {
   margin: 0;
   padding: 8px 12px;
@@ -165,7 +166,7 @@ body[data-view='loading'] .screen-dots i:nth-child(3) { animation-delay: 0.3s; }
 .msg.mine { flex-direction: row-reverse; }
 .msg.mine .body { align-items: flex-end; }
 .msg.mine .meta { flex-direction: row-reverse; }
-.msg.mine .text { background: var(--who); border-color: var(--who); color: #fff; border-radius: 14px 4px 14px 14px; }
+.msg.mine .text { background: var(--who); border-color: var(--who); color: var(--who-ink, #fff); border-radius: 14px 4px 14px 14px; }
 
 .composer { display: flex; gap: 10px; align-items: flex-end; padding: 12px 20px 4px; border-top: 1px solid var(--line); }
 .composer textarea {
@@ -214,5 +215,7 @@ body[data-view='loading'] .screen-dots i:nth-child(3) { animation-delay: 0.3s; }
 .rooms .code { font-size: 18px; font-weight: 600; letter-spacing: 0.1em; }
 .rooms .who { display: flex; flex-direction: column; gap: 4px; }
 .rooms .who span { display: block; color: var(--muted); font-size: 12px; }
+.rooms .actions { white-space: nowrap; text-align: right; }
+.rooms .actions .btn + .btn { margin-left: 8px; }
 .empty { color: var(--muted); padding: 24px 0; }
 .err { color: var(--danger); font-size: 14px; }
diff --git a/web/app.js b/web/app.js
index adc212d..7d80771 100644
--- a/web/app.js
+++ b/web/app.js
@@ -130,7 +130,8 @@ async function boot() {
   const s = r.body;
   if (!s.exists) return showScreen('房间不存在', '检查一下链接是否完整，或者新建一个房间。', { newRoom: true });
   if (s.state === 'ended') return showScreen('房间已结束', endedText(s.reason, ''), { newRoom: true });
-  const returning = Boolean(getToken(id));
+  // 管理员可以进入锁定或已满的房间（服务端同样放行）
+  const returning = Boolean(getToken(id)) || st.body.admin;
   if (s.locked && !returning) return showScreen('房间已锁定', '房间里的人暂时不允许新成员加入。', { newRoom: true });
   if (s.full && !returning) return showScreen('房间已满', '这个房间的人数已达上限。', { newRoom: true });
   enter(id);
@@ -295,6 +296,7 @@ const timeFmt = new Intl.DateTimeFormat('zh-CN', { hour: '2-digit', minute: '2-d
 function avatar(who, size = '') {
   const d = el('span', `dot ${size}`, who.initial);
   d.style.background = who.color;
+  d.style.color = who.ink;
   d.title = who.name;
   return d;
 }
@@ -305,6 +307,7 @@ function renderMessage(msg, prev, next) {
   const row = el('article', `msg${mine ? ' mine' : ''}`);
   if (prev && prev.uid === msg.uid && msg.ts - prev.ts < 120000) row.classList.add('cont');
   row.style.setProperty('--who', who.color);
+  row.style.setProperty('--who-ink', who.ink);
   row.append(avatar(who));
   const body = el('div', 'body');
   const meta = el('div', 'meta');
diff --git a/web/identity.js b/web/identity.js
index 3ea93c9..6c21366 100644
--- a/web/identity.js
+++ b/web/identity.js
@@ -21,6 +21,17 @@ const hash = (s) => {
   return h;
 };
 
+// 头像颜色：OKLCH 色彩空间，色相 0–359 连续取值，再叠加 4 档明度和 3 档彩度，
+// 可区分的颜色比原来"只变色相"多出一个数量级。浅色头像配深色文字，保证可读。
+const LIGHTNESS = [0.5, 0.58, 0.66, 0.74];
+const CHROMA = [0.12, 0.16, 0.2];
+const colorFor = (uid) => {
+  const l = LIGHTNESS[hash(uid + '#l') % LIGHTNESS.length];
+  const c = CHROMA[hash(uid + '#s') % CHROMA.length];
+  const h = hash(uid + '#c') % 360;
+  return { color: `oklch(${l} ${c} ${h})`, ink: l >= 0.66 ? '#15191f' : '#ffffff' };
+};
+
 export const identityFor = (uid) => {
   const h = hash(uid);
   const animal = ANIMALS[h % ANIMALS.length];
@@ -28,7 +39,7 @@ export const identityFor = (uid) => {
     uid,
     name: ADJ[hash(uid + '#a') % ADJ.length] + animal,
     initial: animal[0],
-    color: `hsl(${hash(uid + '#c') % 360} 58% 46%)`,
+    ...colorFor(uid),
   };
 };
 
